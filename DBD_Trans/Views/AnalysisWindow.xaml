<Window x:Class="DBD_Trans.Views.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DBD_Trans.Views"
        xmlns:viewModels="clr-namespace:DBD_Trans.ViewModels"
        xmlns:models="clr-namespace:DBD_Trans.Models"
        xmlns:converters="clr-namespace:DBD_Trans.Converters"
        Title="{Binding Title}" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#FF1E1E1E"
        ResizeMode="CanResizeWithGrip"
        FocusVisualStyle="{x:Null}"
        Focusable="True">
    <!-- ===== НАЧАЛО НОВОГО БЛОКА ===== -->
    <Window.InputBindings>
        <!-- Alt + M: Маркер -->
        <KeyBinding Key="Z" Modifiers="Alt" Command="{Binding ToggleMarkerCommand}" />

        <!-- Alt + S: Разделение по предложениям -->
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding ToggleSplitCommand}" />

        <!-- Alt + F: Режим фокуса -->
        <KeyBinding Key="F" Modifiers="Alt" Command="{Binding ToggleFocusCommand}" />
    </Window.InputBindings>
    <!-- ===== КОНЕЦ НОВОГО БЛОКА ===== -->
    <Window.Resources>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToScrollBarVisibilityConverter x:Key="BoolToScrollBarVisibilityConverter"/>
        
        <SolidColorBrush x:Key="BackgroundDark" Color="#FF171717"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#FF212121"/>
        <SolidColorBrush x:Key="ForegroundPrimary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="ForegroundSecondary" Color="#FFA0A0A0"/>
        <SolidColorBrush x:Key="BorderDark" Color="#FF333333"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#FF3D1C1C"/>
        <SolidColorBrush x:Key="CompletedBlue" Color="#FF232E48"/>

        <Style x:Key="CompletedToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                        CornerRadius="3"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CompletedBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для кнопок панели инструментов -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Оранжевая обводка при наведении -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource WarningOrange}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <!-- Легкая подсветка при нажатии -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33CA5100"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Оранжевая обводка при наведении -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource WarningOrange}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <!-- Оранжевый фон при активации (для Фокуса и Разделения) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WarningOrange}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для темного ContextMenu -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundPrimary}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="3" Margin="2,1">
                            <Grid>
                                <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Header}" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource WarningOrange}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ForegroundSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BorderDark}"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WarningOrange}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="3"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="3"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для ScrollBar -->
        <Style x:Key="ScrollBarButtonStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource BorderDark}" CornerRadius="6" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmoothScrollTextBox" TargetType="TextBox">
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="2" 
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="ErrorsRow" Height="0.18*" MinHeight="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Замени существующие кнопки Маркера и Выполнено на этот блок -->
        <!-- Верхняя панель инструментов -->
        <!-- Верхняя панель инструментов -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">

            <!-- ГРУППА 1: Размер шрифта -->
            <TextBlock Text="🔤" FontSize="16" Foreground="{StaticResource ForegroundSecondary}" VerticalAlignment="Center" Margin="0,0,5,0" ToolTip="Размер шрифта"/>
            <Button Content="−" Command="{Binding DecreaseFontCommand}" ToolTip="Уменьшить шрифт" 
            Style="{StaticResource ToolbarButtonStyle}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding FontSize, StringFormat={}{0:F0}}" Foreground="{StaticResource ForegroundPrimary}" 
               VerticalAlignment="Center" Margin="5,0" MinWidth="20" TextAlignment="Center" FontWeight="SemiBold"/>
            <Button Content="+" Command="{Binding IncreaseFontCommand}" ToolTip="Увеличить шрифт" 
            Style="{StaticResource ToolbarButtonStyle}" FontSize="16" FontWeight="Bold"/>

            <!-- Разделитель -->
            <Border Width="1" Height="20" Background="{StaticResource BorderDark}" Margin="15,0,10,0"/>

            <!-- ГРУППА 2: Поиск -->
            <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="3" Background="{StaticResource BackgroundLight}" Width="200" Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" Foreground="{StaticResource ForegroundSecondary}" VerticalAlignment="Center" Margin="8,0,6,0" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundPrimary}" VerticalContentAlignment="Center" CaretBrush="{StaticResource ForegroundPrimary}"/>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <Border Width="1" Height="20" Background="{StaticResource BorderDark}" Margin="15,0,10,0"/>

            <!-- ГРУППА 3: Инструменты -->
            <Button Content="🖍️" Command="{Binding ToggleMarkerCommand}" ToolTip="Маркер"
            Background="{Binding IsMarkerActive, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=#CA5100}"
            Foreground="White" Style="{StaticResource ToolbarButtonStyle}"/>

            <ToggleButton Content="📑" IsChecked="{Binding IsSplitBySentences}" ToolTip="Разделение по предложениям"
                  Style="{StaticResource ToolbarToggleButtonStyle}"/>

            <ToggleButton Content="🎯" IsChecked="{Binding IsFocusMode}" ToolTip="Режим фокуса"
                  Style="{StaticResource ToolbarToggleButtonStyle}"
                  Visibility="{Binding IsSplitBySentences, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Разделитель -->
            <Border Width="1" Height="20" Background="{StaticResource BorderDark}" Margin="15,0,10,0"/>

            <!-- ГРУППА 4: Статус (перенесено в конец) -->
            <Button Content="✔️" Command="{Binding ToggleCompletedCommand}" ToolTip="Отметить как выполненное"
            Background="{Binding CompletedButtonBrush}" Foreground="White" 
            Style="{StaticResource ToolbarButtonStyle}"/>

            <!-- ===== НОВОЕ: Индикатор быстрого перехода ===== -->
            <TextBlock Text="{Binding JumpBufferText}" 
           Foreground="{StaticResource WarningOrange}" 
           FontWeight="SemiBold" 
           VerticalAlignment="Center" 
           Margin="15,0,0,0"
           FontSize="14"/>
            <!-- ================================================ -->

        </StackPanel>
        <!-- Тексты -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="2" Grid.Row="0" Text="Английский:" Foreground="{StaticResource ForegroundSecondary}" Margin="5,0,0,3"/>
            <!-- Английский -->
            <Border Grid.Column="2" Grid.Row="1" Background="{StaticResource BackgroundLight}" BorderBrush="{StaticResource BorderDark}" 
        BorderThickness="1" CornerRadius="3" Margin="5,0,0,0">
                <ScrollViewer x:Name="EnglishScrollViewer" 
              VerticalScrollBarVisibility="{Binding IsFocusMode, Converter={StaticResource BoolToScrollBarVisibilityConverter}}" 
              CanContentScroll="False">
                    <RichTextBox x:Name="EnglishRichTextBox" 
                             AutoWordSelection="False"
             IsReadOnly="True"
             BorderThickness="0"
             Background="Transparent"
             Foreground="{StaticResource ForegroundPrimary}"
             FontSize="{Binding FontSize}"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Hidden"
             HorizontalScrollBarVisibility="Hidden"
             ScrollViewer.CanContentScroll="False"
             LostFocus="RichTextBox_LostFocus"
                                     PreviewMouseWheel="RichTextBox_PreviewMouseWheel"

             PreviewMouseLeftButtonDown="RichTextBox_PreviewMouseLeftButtonDown"
             PreviewMouseLeftButtonUp="RichTextBox_PreviewMouseLeftButtonUp"
                                 PreviewMouseMove="RichTextBox_PreviewMouseMove"
                                 PreviewMouseRightButtonDown="RichTextBox_PreviewMouseRightButtonDown"
MouseLeave="RichTextBox_MouseLeave">

                        <FlowDocument>
                            <Paragraph>
                                <Run Text="{Binding EnglishText, Mode=OneWay}"/>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Column="0" Grid.Row="0" Text="Русский:" Foreground="{StaticResource ForegroundSecondary}" Margin="0,0,0,3"/>
            <!-- Русский RichTextBox -->
            <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource BackgroundLight}" BorderBrush="{StaticResource BorderDark}" 
        BorderThickness="1" CornerRadius="3" Margin="0,0,5,0">

                <ScrollViewer x:Name="RussianScrollViewer" 
              VerticalScrollBarVisibility="{Binding IsFocusMode, Converter={StaticResource BoolToScrollBarVisibilityConverter}}" 
              CanContentScroll="False">
                    <RichTextBox x:Name="RussianRichTextBox" 
                                 AutoWordSelection="False"
             IsReadOnly="True"
             BorderThickness="0"
             Background="Transparent"
             Foreground="{StaticResource ForegroundPrimary}"
             FontSize="{Binding FontSize}"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Hidden"
             HorizontalScrollBarVisibility="Hidden"
             LostFocus="RichTextBox_LostFocus"
             PreviewMouseLeftButtonDown="RichTextBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseWheel="RichTextBox_PreviewMouseWheel"

             ScrollViewer.CanContentScroll="False" 
             PreviewMouseLeftButtonUp="RichTextBox_PreviewMouseLeftButtonUp"
              PreviewMouseMove="RichTextBox_PreviewMouseMove"
                                 PreviewMouseRightButtonDown="RichTextBox_PreviewMouseRightButtonDown"
                                 
MouseLeave="RichTextBox_MouseLeave"
                                 >
                        <FlowDocument>
                            <Paragraph>
                                <Run Text="{Binding RussianText, Mode=OneWay}"/>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" 
                      Background="{StaticResource BorderDark}" ResizeBehavior="PreviousAndNext" 
                      ResizeDirection="Rows" ShowsPreview="True" Margin="0,5,0,5"/>

        <!-- Список ошибок -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ДОБАВЬ x:Name="ErrorsHeaderPanel" и Background="Transparent" -->
            <StackPanel x:Name="ErrorsHeaderPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5" 
            Background="Transparent" Cursor="Hand">
                <TextBlock Text="⚠ Замечания к переводу:" Foreground="{StaticResource WarningOrange}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Errors.Count, StringFormat='({0})'}" Foreground="{StaticResource ForegroundSecondary}" Margin="5,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource BackgroundLight}" BorderBrush="{StaticResource BorderDark}" 
                    BorderThickness="1" CornerRadius="3">
                <ListBox x:Name="ErrorsListBox" ItemsSource="{Binding Errors}" SelectedItem="{Binding SelectedError}"
                         Background="Transparent" Foreground="{StaticResource ForegroundPrimary}"
                         BorderThickness="0" SelectionMode="Single"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ErrorItem}">
                            <!-- Аналогично исходному шаблону, но с командами -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="•" Foreground="{StaticResource WarningOrange}" 
                                           FontSize="14" VerticalAlignment="Top" Margin="0,-1,6,0"/>

                                <Grid Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock x:Name="DisplayText" Text="{Binding Text}" TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>
                                    <TextBox x:Name="EditBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="Collapsed" TextWrapping="Wrap" AcceptsReturn="False"
                                             Background="{StaticResource BackgroundLight}" Foreground="{StaticResource ForegroundPrimary}"
                                             BorderBrush="{StaticResource WarningOrange}" BorderThickness="1" Padding="2"
                                             LostFocus="EditBox_LostFocus" KeyDown="EditBox_KeyDown"
                                             VerticalAlignment="Top"/>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="MouseDoubleClick" Handler="ErrorsListBoxItem_MouseDoubleClick" />
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="Transparent" BorderThickness="0"
                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Сначала наведение -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1ACA5100"/>
                                            </Trigger>
                                            <!-- Затем выделение (перекроет наведение) -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#2ACA5100"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Grid>

        <!-- Добавление новой ошибки -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewErrorTextBox" Grid.Column="0" Text="{Binding NewErrorText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource BackgroundLight}" Foreground="{StaticResource ForegroundPrimary}" 
                     BorderBrush="{StaticResource BorderDark}" Padding="6" VerticalContentAlignment="Center"
                     KeyDown="NewErrorTextBox_KeyDown" GotFocus="NewErrorTextBox_GotFocus"/>
            <Button Grid.Column="1" Content="Добавить" Width="80" Margin="10,0,0,0" Command="{Binding AddErrorCommand}"
                    Style="{StaticResource AddButtonStyle}">
            </Button>
            <Button Grid.Column="2" Content="Удалить" Width="80" Margin="5,0,0,0" Command="{Binding DeleteErrorCommand}"
                    CommandParameter="{Binding SelectedError}"
                    Style="{StaticResource DeleteButtonStyle}">
            </Button>
        </Grid>
    </Grid>
</Window>